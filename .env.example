# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
APP_NAME="Wi-Fi Billing SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# ─────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────
# Database (matches docker-compose service name "db")
# ─────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=wifi_billing
DB_USERNAME=wifi_app
DB_PASSWORD=change_me_in_local_env

# ─────────────────────────────────────────────────────────────
# Docker-specific (used by docker-compose variable substitution)
# ─────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=root_password_change_me
APP_PORT=8000

# Optional demo-account passwords for `php artisan db:seed`; set both or leave
# both empty to generate random passwords for new accounts. Never commit real passwords.
SEED_ADMIN_PASSWORD=
SEED_TENANT_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Session / Cache / Queue
# ─────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ─────────────────────────────────────────────────────────────
# Redis (matches docker-compose service name "redis")
# ─────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=local_dev_redis_password_change_me
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────
# Mail (dev: logs to storage/logs/laravel.log)
# ─────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────
# MikroTik (sandbox / dev router only — NEVER commit real creds)
# ─────────────────────────────────────────────────────────────
MIKROTIK_HOST=
MIKROTIK_PORT=8728
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
MIKROTIK_USE_SSL=false
MIKROTIK_TIMEOUT=5

# Flutterwave (store production credentials in platform configuration when possible)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_ENVIRONMENT=sandbox
PAYMENT_SIMULATION_ENABLED=false
SITE_AGENT_REQUIRED=false
ALLOW_DIRECT_ROUTER_CONNECTION=false
MIKROTIK_SSL_VERIFY_PEER=true
MIKROTIK_CA_CERT_PATH=

# WireGuard server interface is provisioned by host operations (Linux only).
WIREGUARD_ENABLED=false
WIREGUARD_INTERFACE=wg0
WIREGUARD_SERVER_ADDRESS=10.8.0.1
WIREGUARD_ENDPOINT=
WIREGUARD_LISTEN_PORT=51820
WIREGUARD_KEEPALIVE=25

# Site-local worker only. Never set router credentials on the SaaS deployment.
# SITE_AGENT_URL=https://your-saas-domain.example
# SITE_AGENT_TOKEN=issued-once-with-php-artisan-site-agent:issue-token
# SITE_AGENT_ROUTERS={"1":{"host":"192.168.88.1","username":"billing-api","password":"local-router-secret","port":8728}}

# Mobile money API endpoints (defaults are the providers' standard URLs)
MTN_MOMO_SANDBOX_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_PRODUCTION_URL=https://proxy.momoapi.mtn.com
MTN_MOMO_WEBHOOK_URL=
AIRTEL_MONEY_SANDBOX_URL=https://openapiuat.airtel.africa
AIRTEL_MONEY_PRODUCTION_URL=https://openapi.airtel.africa
AIRTEL_MONEY_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────
# Vite / frontend
# ─────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"