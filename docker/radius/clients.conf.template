# Matches the WireGuard peer allocation in WireGuardService.
client wireguard_peers {
    ipaddr = 10.8.0.0/16
    dynamic_clients = dynamic_clients
    require_message_authenticator = yes
    lifetime = 30
}

client radius_healthcheck {
    ipaddr = 172.16.0.0/12
    secret = ${RADIUS_HEALTH_SECRET}
    require_message_authenticator = no
}
