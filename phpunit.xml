<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_URL" value="http://localhost:8000"/>
        <env name="APP_TIMEZONE" value="Africa/Kampala"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="TEST_DB_DRIVER" value="sqlite" force="true"/>
        <env name="TEST_EXPECTED_DB_DRIVER" value="sqlite" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PLATFORM_ADMIN_MFA_REQUIRED" value="false"/>
        <env name="MFA_STEP_UP_ENABLED" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SEED_ADMIN_PASSWORD" value="Platform-test-password-2026!"/>
        <env name="SEED_TENANT_PASSWORD" value="Operator-test-password-2026!"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="WIREGUARD_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
